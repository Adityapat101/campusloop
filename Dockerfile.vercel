FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace
COPY .mvn .mvn
COPY mvnw pom.xml ./
RUN chmod +x mvnw && ./mvnw -B dependency:go-offline
COPY src src
RUN ./mvnw -B verify

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN groupadd --system campusloop && useradd --system --gid campusloop campusloop
COPY --from=build --chown=campusloop:campusloop /workspace/target/student-marketplace-0.0.1-SNAPSHOT.jar app.jar
ENV SPRING_PROFILES_ACTIVE=production
ENV PORT=8080
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65 -XX:+ExitOnOutOfMemoryError -XX:TieredStopAtLevel=1"
USER campusloop
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
